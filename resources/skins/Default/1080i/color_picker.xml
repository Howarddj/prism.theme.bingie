<?xml version="1.0" encoding="UTF-8"?>
<!-- Prism theme for Bingie -->
<window type="dialog">
    <defaultcontrol always="true">3110</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="fade" start="0" end="100" time="300"/>
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="fade" start="100" end="0" time="250"/>
    </animation>
    <controls>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture>bingie_white.png</texture>
            <colordiffuse>B3000000</colordiffuse>
        </control>
        <control type="image">
            <left>40</left>
            <top>40</top>
            <width>1840</width>
            <height>1000</height>
            <texture border="12">bingie_panel.png</texture>
            <colordiffuse>$INFO[Skin.String(ButtonColor)]</colordiffuse>
        </control>
        <control type="label" id="1">
            <left>80</left>
            <top>70</top>
            <width>1100</width>
            <height>70</height>
            <aligny>center</aligny>
            <font>Bold38</font>
            <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
            <label>$ADDON[plugin.video.prism 30854]</label>
        </control>
        <control type="button" id="3030">
            <right>80</right>
            <top>75</top>
            <width>560</width>
            <height>60</height>
            <font>Reg26</font>
            <align>right</align>
            <aligny>center</aligny>
            <textoffsetx>24</textoffsetx>
            <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
            <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
            <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
            <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
            <pulseonselect>false</pulseonselect>
            <ondown>3110</ondown>
            <label>$ADDON[plugin.video.prism 30855]: [B]$INFO[Window.Property(palettename)][/B]</label>
            <visible>!String.IsEmpty(Window.Property(palettename))</visible>
        </control>
        <control type="scrollbar" id="60">
            <left>1846</left>
            <top>165</top>
            <width>8</width>
            <height>745</height>
            <texturesliderbackground border="3" colordiffuse="$INFO[Skin.String(ScrollbarBackgroundColor)]">bingie_bar.png</texturesliderbackground>
            <texturesliderbar border="3" colordiffuse="$INFO[Skin.String(ScrollbarUnfocusedColor)]">bingie_bar.png</texturesliderbar>
            <texturesliderbarfocus border="3" colordiffuse="$INFO[Skin.String(ScrollbarFocusedColor)]">bingie_bar.png</texturesliderbarfocus>
            <textureslidernib></textureslidernib>
            <textureslidernibfocus></textureslidernibfocus>
            <pulseonselect>false</pulseonselect>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <onleft>3110</onleft>
        </control>
        <control type="panel" id="3110">
            <viewtype label="31438">icons</viewtype>
            <left>80</left>
            <top>165</top>
            <width>1750</width>
            <height>745</height>
            <orientation>vertical</orientation>
            <onleft>3110</onleft>
            <onright>60</onright>
            <onup>3030</onup>
            <ondown>3010</ondown>
            <preloaditems>4</preloaditems>
            <pagecontrol>60</pagecontrol>
            <itemlayout height="45" width="58" condition="!String.IsEqual(Window.Property(palettename),basic) + !String.IsEqual(Window.Property(palettename),material-design)">
                <control type="image">
                    <left>3</left>
                    <top>3</top>
                    <width>52</width>
                    <height>39</height>
                    <texture border="5">$INFO[ListItem.Icon]</texture>
                </control>
            </itemlayout>
            <focusedlayout height="45" width="58" condition="!String.IsEqual(Window.Property(palettename),basic) + !String.IsEqual(Window.Property(palettename),material-design)">
                <control type="group">
                    <animation effect="zoom" time="200" tween="sine" easing="inout" start="100" end="260" center="auto">Focus</animation>
                    <control type="image">
                        <width>58</width>
                        <height>45</height>
                        <texture border="5">bingie_white.png</texture>
                        <colordiffuse>$INFO[Skin.String(ViewDetailsBorderFocusColor)]</colordiffuse>
                    </control>
                    <control type="image">
                        <left>3</left>
                        <top>3</top>
                        <width>52</width>
                        <height>39</height>
                        <texture border="5">$INFO[ListItem.Icon]</texture>
                    </control>
                </control>
            </focusedlayout>
            <itemlayout height="76" width="125" condition="String.IsEqual(Window.Property(palettename),basic)">
                <control type="image">
                    <left>3</left>
                    <top>3</top>
                    <width>119</width>
                    <height>70</height>
                    <texture border="5">$INFO[ListItem.Icon]</texture>
                </control>
            </itemlayout>
            <focusedlayout height="76" width="125" condition="String.IsEqual(Window.Property(palettename),basic)">
                <control type="group">
                    <animation effect="zoom" time="200" tween="sine" easing="inout" start="100" end="150" center="auto">Focus</animation>
                    <control type="image">
                        <width>125</width>
                        <height>76</height>
                        <texture border="5">bingie_white.png</texture>
                        <colordiffuse>$INFO[Skin.String(ViewDetailsBorderFocusColor)]</colordiffuse>
                    </control>
                    <control type="image">
                        <left>3</left>
                        <top>3</top>
                        <width>119</width>
                        <height>70</height>
                        <texture border="5">$INFO[ListItem.Icon]</texture>
                    </control>
                </control>
            </focusedlayout>
            <itemlayout height="40" width="125" condition="String.IsEqual(Window.Property(palettename),material-design)">
                <control type="image">
                    <left>3</left>
                    <top>3</top>
                    <width>119</width>
                    <height>34</height>
                    <texture border="5">$INFO[ListItem.Icon]</texture>
                </control>
            </itemlayout>
            <focusedlayout height="40" width="125" condition="String.IsEqual(Window.Property(palettename),material-design)">
                <control type="group">
                    <animation effect="zoom" time="200" tween="sine" easing="inout" start="100" end="150" center="auto">Focus</animation>
                    <control type="image">
                        <width>125</width>
                        <height>40</height>
                        <texture border="5">bingie_white.png</texture>
                        <colordiffuse>$INFO[Skin.String(ViewDetailsBorderFocusColor)]</colordiffuse>
                    </control>
                    <control type="image">
                        <left>3</left>
                        <top>3</top>
                        <width>119</width>
                        <height>34</height>
                        <texture border="5">$INFO[ListItem.Icon]</texture>
                    </control>
                </control>
            </focusedlayout>
        </control>

        <!-- Bottom bar -->
        <control type="label">
            <left>80</left>
            <top>918</top>
            <width>900</width>
            <height>40</height>
            <aligny>center</aligny>
            <font>Bold26</font>
            <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
            <label>$INFO[Window.Property(colorname)]</label>
        </control>
        <control type="grouplist">
            <left>80</left>
            <top>962</top>
            <width>1760</width>
            <height>60</height>
            <orientation>horizontal</orientation>
            <itemgap>16</itemgap>
            <control type="group">
                <width>100</width>
                <height>60</height>
                <control type="image">
                    <texture border="8">bingie_button.png</texture>
                    <colordiffuse>$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]</colordiffuse>
                </control>
                <control type="image">
                    <left>6</left>
                    <top>6</top>
                    <width>88</width>
                    <height>48</height>
                    <texture border="4">bingie_button.png</texture>
                    <colordiffuse>$INFO[Window.Property(colorstring)]</colordiffuse>
                </control>
            </control>
            <control type="button" id="3010">
                <width>460</width>
                <height>60</height>
                <font>Reg26</font>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
                <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
                <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
                <pulseonselect>false</pulseonselect>
                <label>$ADDON[plugin.video.prism 30856]</label>
                <label2>$INFO[Window.Property(colorstring)]</label2>
                <onup>3110</onup>
                <ondown>SetFocus(3110,1)</ondown>
                <onright>3012</onright>
            </control>
            <control type="button" id="3012">
                <width>220</width>
                <height>60</height>
                <font>Reg26</font>
                <align>center</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
                <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
                <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
                <pulseonselect>false</pulseonselect>
                <label>$LOCALIZE[190]</label>
                <onup>3110</onup>
                <onleft>3010</onleft>
                <onright>3011</onright>
            </control>
            <control type="button" id="3011">
                <width>220</width>
                <height>60</height>
                <font>Reg26</font>
                <align>center</align>
                <aligny>center</aligny>
                <textoffsetx>24</textoffsetx>
                <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
                <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
                <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
                <pulseonselect>false</pulseonselect>
                <label>$ADDON[plugin.video.prism 30857]</label>
                <onup>3110</onup>
                <onleft>3012</onleft>
                <onright>3015</onright>
            </control>
            <control type="group" id="3020">
                <width>520</width>
                <height>60</height>
                <control type="label" id="3016">
                    <left>20</left>
                    <width>160</width>
                    <height>60</height>
                    <aligny>center</aligny>
                    <font>Reg26</font>
                    <textcolor>$INFO[Skin.String(BingieDeatailsTextColor)]</textcolor>
                    <label>$ADDON[plugin.video.prism 30858]</label>
                </control>
                <control type="slider" id="3015">
                    <left>180</left>
                    <top>18</top>
                    <width>240</width>
                    <height>24</height>
                    <onup>3011</onup>
                    <ondown>3011</ondown>
                    <onleft>3011</onleft>
                    <texturesliderbar border="4" colordiffuse="4DFFFFFF">bingie_slider_bar.png</texturesliderbar>
                    <textureslidernib colordiffuse="$INFO[Skin.String(GeneralTextColor)]">bingie_knob.png</textureslidernib>
                    <textureslidernibfocus colordiffuse="$INFO[Skin.String(BingieProgressBarColor)]">bingie_knob.png</textureslidernibfocus>
                </control>
                <control type="label" id="3017">
                    <left>430</left>
                    <width>90</width>
                    <height>60</height>
                    <align>right</align>
                    <aligny>center</aligny>
                    <font>Bold26</font>
                    <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                    <label>$INFO[Control.GetLabel(3015)]</label>
                </control>
            </control>
        </control>
    </controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Prism theme for Bingie -->
<window>
    <defaultcontrol always="true">3001</defaultcontrol>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <onload>Dialog.Close(videoosd,true)</onload>
    <animation type="WindowOpen" reversible="false">
        <effect type="slide" start="200,0" end="0,0" tween="cubic" easing="out" time="400"/>
        <effect type="fade" start="0" end="100" time="300"/>
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="fade" start="100" end="0" time="250"/>
    </animation>
    <controls>
        <control type="grouplist">
            <right>70</right>
            <bottom>100</bottom>
            <width>800</width>
            <height>64</height>
            <orientation>horizontal</orientation>
            <align>right</align>
            <itemgap>14</itemgap>
                <control type="radiobutton" id="3001">
                    <width>300</width>
                    <height>64</height>
                    <font>Reg28</font>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textoffsetx>72</textoffsetx>
                    <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                    <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
                    <label>$INFO[Window().Property(skip.label)]</label>
                    <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
                    <textureradioonfocus colordiffuse="$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]">bingie_icon_forward.png</textureradioonfocus>
                    <textureradioofffocus colordiffuse="$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]">bingie_icon_forward.png</textureradioofffocus>
                    <textureradioonnofocus colordiffuse="$INFO[Skin.String(GeneralTextColor)]">bingie_icon_forward.png</textureradioonnofocus>
                    <textureradiooffnofocus colordiffuse="$INFO[Skin.String(GeneralTextColor)]">bingie_icon_forward.png</textureradiooffnofocus>
                    <radioposx>28</radioposx>
                    <radioposy>20</radioposy>
                    <radiowidth>24</radiowidth>
                    <radioheight>24</radioheight>
                    <pulseonselect>false</pulseonselect>
                </control>
                <control type="radiobutton" id="3002">
                    <width>180</width>
                    <height>64</height>
                    <font>Reg28</font>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textoffsetx>72</textoffsetx>
                    <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                    <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
                    <label>$ADDON[plugin.video.prism 30459]</label>
                    <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
                    <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
                    <textureradioonfocus colordiffuse="$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]">bingie_icon_close.png</textureradioonfocus>
                    <textureradioofffocus colordiffuse="$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]">bingie_icon_close.png</textureradioofffocus>
                    <textureradioonnofocus colordiffuse="$INFO[Skin.String(GeneralTextColor)]">bingie_icon_close.png</textureradioonnofocus>
                    <textureradiooffnofocus colordiffuse="$INFO[Skin.String(GeneralTextColor)]">bingie_icon_close.png</textureradiooffnofocus>
                    <radioposx>28</radioposx>
                    <radioposy>20</radioposy>
                    <radiowidth>24</radiowidth>
                    <radioheight>24</radioheight>
                    <pulseonselect>false</pulseonselect>
                </control>
        </control>
    </controls>
</window>

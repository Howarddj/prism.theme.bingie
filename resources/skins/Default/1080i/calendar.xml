                                <aligny>center</aligny>
                                <font>Reg22</font>
                                <textcolor>$INFO[Skin.String(BingieSecondaryTextColor)]</textcolor>
                                <label>$INFO[ListItem.Property(genres)]</label>
                                <visible>!String.IsEmpty(ListItem.Property(genres))</visible>
                            </control>
                        </control>
                    </control>
                    <control type="image">
                        <width>860</width>
                        <height>280</height>
                        <texture border="8">bingie_button_border.png</texture>
                        <colordiffuse>$INFO[Skin.String(ViewDetailsBorderFocusColor)]</colordiffuse>
                    </control>
            </focusedlayout>

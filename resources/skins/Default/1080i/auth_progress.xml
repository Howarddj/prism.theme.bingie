<?xml version="1.0" encoding="UTF-8"?>
<!-- Prism theme for Bingie -->
<window type="dialog">
    <defaultcontrol always="true">4001</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="fade" start="0" end="100" time="300"/>
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="fade" start="100" end="0" time="250"/>
    </animation>
    <controls>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture>bingie_white.png</texture>
            <colordiffuse>D9000000</colordiffuse>
        </control>
        <control type="group">
            <left>510</left>
            <top>120</top>
            <animation effect="zoom" start="95" end="100" center="auto" time="300" tween="cubic" easing="out">WindowOpen</animation>
            <control type="image">
            <left>0</left>
            <top>0</top>
            <width>900</width>
            <height>840</height>
            <texture border="12">bingie_panel.png</texture>
            <colordiffuse>$INFO[Skin.String(ButtonColor)]</colordiffuse>
        </control>
            <control type="label" id="3002">
                <left>40</left>
                <top>40</top>
                <width>820</width>
                <height>60</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>Bold38</font>
                <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                <label>$INFO[Window.Property(auth.heading)]</label>
            </control>
            <control type="image">
                <left>225</left>
                <top>130</top>
                <width>450</width>
                <height>450</height>
                <texture border="12">bingie_panel.png</texture>
                <colordiffuse>FFFFFFFF</colordiffuse>
            </control>
            <control type="image">
                <left>245</left>
                <top>150</top>
                <width>410</width>
                <height>410</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Window.Property(qr_code)]</texture>
            </control>
            <control type="textbox" id="3005">
                <left>60</left>
                <top>600</top>
                <width>780</width>
                <height>80</height>
                <align>center</align>
                <font>Reg26</font>
                <textcolor>$INFO[Skin.String(BingieDeatailsTextColor)]</textcolor>
                <label>$INFO[Window.Property(auth.text)]</label>
            </control>
            <control type="progress" id="3003">
                <left>150</left>
                <top>700</top>
                <width>600</width>
                <height>6</height>
                <texturebg colordiffuse="33FFFFFF">bingie_white.png</texturebg>
                <lefttexture></lefttexture>
                <midtexture colordiffuse="$INFO[Skin.String(BingieProgressBarColor)]">bingie_white.png</midtexture>
                <righttexture></righttexture>
            </control>
            <control type="button" id="4001">
                <left>330</left>
                <top>740</top>
                <width>240</width>
                <height>60</height>
                <font>Reg28</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>$INFO[Skin.String(GeneralTextColor)]</textcolor>
                <focusedcolor>$INFO[Skin.String(BingieSecondaryButtonFocusTextColor)]</focusedcolor>
                <texturefocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderFocusColor)]">bingie_button.png</texturefocus>
                <texturenofocus border="8" colordiffuse="$INFO[Skin.String(ViewDetailsBorderUnfocusColor)]">bingie_button.png</texturenofocus>
                <pulseonselect>false</pulseonselect>
                <label>$ADDON[plugin.video.prism 30070]</label>
            </control>
        </control>
    </controls>
</window>
